APP_NAME="Medical Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
# Business timezone used for schedules and display (stored timestamps are UTC timestamptz)
BUSINESS_TIMEZONE=Africa/Cairo
FRONTEND_URL=http://localhost:3000
# Requests/minute per user or IP. Local dev runs many E2E agents from 127.0.0.1, so raise it there.
API_RATE_LIMIT=120
# New urgent requests (POST /urgent-requests) per hour per IP. Raise for local E2E runs from one IP.
URGENT_IP_RATE_LIMIT=10

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=medical_booking
DB_USERNAME=medical_user
# Development-only value matching scripts/dev-services.sh. Never reuse in production.
DB_PASSWORD=medical_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=medical_booking_cache_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes emails to storage/logs; set smtp + credentials to deliver real mail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@medical-booking.test"
MAIL_FROM_NAME="${APP_NAME}"

# Platform defaults (overridable at runtime in admin settings)
EMERGENCY_NUMBER=123
